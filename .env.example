# Supabase — copie para .env e preencha. NUNCA commite o .env.
SUPABASE_URL=https://husxtmfkgeyxyygsmpnk.supabase.co
# Chave pública (publishable/anon): pode ir para o front-end
SUPABASE_ANON_KEY=
# Chave secreta (service_role/secret): só no servidor/scripts de sync
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta Postgres (opcional, para psycopg/migrações)
# Session pooler (funciona em redes IPv4). Alternativa direta (só IPv6):
# postgresql://postgres:[SUA-SENHA]@db.husxtmfkgeyxyygsmpnk.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.husxtmfkgeyxyygsmpnk:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave da API do CSFloat (opcional): habilita a checagem de float (refine-floats)
CSFLOAT_API_KEY=
# Moeda padrão dos comandos e do site (BRL, USD, EUR...)
TRADEUP_CURRENCY=BRL
# De onde o site lê os preços: "snapshot" (arquivo local gerado pela coleta) ou
# "supabase" (banco na nuvem; use nos computadores que só abrem o site)
TRADEUP_PRICE_SOURCE=snapshot
